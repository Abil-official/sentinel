{
    "name": "laravel/sentinel",
    "version": "0.0.1",
    "type": "library",
    "authors": [
        {
            "name": "Mior Muhammad Zaki",
            "email": "mior@laravel.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Laravel\\Sentinel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "workbench/app/",
            "Database\\Factories\\": "workbench/database/factories/",
            "Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "require": {
        "illuminate/container": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.9",
        "spatie/laravel-ray": "^1.43",
        "laravel/pint": "^1.27"
    },
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare",
            "@sync"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "sync": [
            "@php vendor/bin/testbench workbench:sync --ansi",
            "@php vendor/bin/testbench vendor:publish --tag=laravel-assets --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    }
}
